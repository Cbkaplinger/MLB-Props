# Copy to `.env` in the repo root (gitignored) or set in your shell.
# Do not commit secrets or machine-specific paths.

# Root used for generated processed artifacts.
MLB_PROPS_DATA_DIR=/path/to/mlb-props-data

# Optional: write models, predictions, and SHAP tables elsewhere.
# MLB_PROPS_OUTPUT_DIR=/path/to/mlb-props-artifacts

# Directory containing regular/<season>/*.parquet Savant exports.
# MLB_PROPS_SAVANT_DATA_DIR=/path/to/savant/regular

# SharpAPI (live odds). Free tier: DK/FD. Never commit the real key.
SHARPAPI_KEY=your_key_here
